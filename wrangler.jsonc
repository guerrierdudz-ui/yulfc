// Configuration Cloudflare Workers pour yulfc.com
// ⚠️ "name" doit être EXACTEMENT le nom du Worker affiché dans le tableau de bord Cloudflare.
{
  "name": "yulfc",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/media/*"]
  },
  "r2_buckets": [
    { "binding": "MEDIA", "bucket_name": "yulfc-media" }
  ]
}
